<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.web.flowershopping.Mapper.UserLoginMapper">

    <select id="selectByOpenId" parameterType="com.web.flowershopping.Entity.User" resultType="com.web.flowershopping.Entity.User">
        select * from `USER_MASTER` where openid = #{openid}
    </select>

    <select id="selectByPhoneNumber" resultType="com.web.flowershopping.Entity.User">
        select * from `USER_MASTER` where tel = #{phoneNumber}
    </select>

    <!-- 插入用户 -->
    <insert id="insertUser"
            parameterType="com.web.flowershopping.Entity.User">

        insert into USER_MASTER(openid, nickname, is_admin, tel)
        values (#{openid}, #{nickName}, 0, #{tel})

    </insert>

</mapper>